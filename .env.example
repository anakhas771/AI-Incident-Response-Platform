PROJECT_NAME=AI Incident Response Platform

ENVIRONMENT=development
DEBUG=True

SECRET_KEY=django-insecure-change-this-in-development

DJANGO_SETTINGS_MODULE=config.settings.development

ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=incident_platform_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_secure_password_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=AI Incident Response Platform
VITE_ENABLE_ANALYTICS=false

COPILOT_LLM_PROVIDER=ollama
COPILOT_LLM_BASE_URL=http://host.docker.internal:11434/v1
COPILOT_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
COPILOT_LLM_TEMPERATURE=0.2
COPILOT_LLM_MAX_TOKENS=64
COPILOT_LLM_TIMEOUT=180
COPILOT_LLM_MAX_RETRIES=1
COPILOT_LLM_BASE_BACKOFF=1.0
COPILOT_LLM_MAX_BACKOFF=30.0