# backend/.env.example

# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-backend-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database
POSTGRES_DB=incident_platform_db
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_secure_password_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Cache & Message Broker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# AI Engine Configuration
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4-turbo

# RAG & Knowledge Base Configuration
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1536
CHUNK_SIZE=500
CHUNK_OVERLAP=100
VECTOR_SEARCH_TOP_K=5
VECTOR_SIMILARITY_THRESHOLD=0.7

# Celery Configuration
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_DEFAULT_QUEUE=default

# AI Copilot Configuration
COPILOT_LLM_PROVIDER=mock
COPILOT_LLM_MODEL=gpt-4-turbo
COPILOT_LLM_TEMPERATURE=0.2
COPILOT_LLM_MAX_TOKENS=768
COPILOT_LLM_TIMEOUT=120
COPILOT_LLM_MAX_RETRIES=0
OPENAI_API_KEY=
